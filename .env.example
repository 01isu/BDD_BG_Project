# ============================================================
# .env.example — Template des variables d'environnement
# ============================================================
# Comment l'utiliser :
#   1. Copier ce fichier en .env :       cp .env.example .env
#   2. Remplir les valeurs ci-dessous
#   3. Lancer le projet :                docker compose up -d
#
# Ne JAMAIS committer le fichier .env (déjà dans .gitignore)
# ============================================================

# ----- API RapidAPI pour KicksCrew -----
# Inscription gratuite : https://rapidapi.com
# Souscrire à : https://rapidapi.com/belchiorarkad-FqvHs2EDOtP/api/kickscrew-sneakers-data
# Récupérer la clé dans : https://rapidapi.com/developer/security
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=kickscrew-sneakers-data.p.rapidapi.com

# ----- Airflow -----
# UID utilisateur Airflow dans le conteneur
# Pour Windows et macOS : laisser 50000
# Pour Linux : utiliser `id -u` pour obtenir ton vrai UID
AIRFLOW_UID=50000